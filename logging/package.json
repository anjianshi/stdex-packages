{
  "name": "@stdex/logging",
  "version": "1.2.0",
  "description": "功能丰富、可扩展的日志记录库",
  "homepage": "https://github.com/anjianshi/stdex-packages/logging",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjianshi/stdex-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clear && tsc",
    "watch": "npm run clear && tsc --watch",
    "clear": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/'",
    "test-node": "node test/node.js",
    "test-browser": "rm -rf test/browser/dist/ && cp -R dist test/browser && cp node_modules/dayjs/dayjs.min.js test/browser/dist/ && serve test/browser"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "default": "./dist/handlers/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-eslint-typescript": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.6.0",
    "serve": "^14.2.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/node": "^26.6.5"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
