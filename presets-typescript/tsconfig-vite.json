{
  "extends": ["./tsconfig-base"],
  "compilerOptions": {
    // 与 moduleResolution 搭配
    // Used together with `moduleResolution`
    "module": "ESNext",

    // 启用 Vite 的文件解析特性（支持在开启了 Module 的项目里不带扩展名引入文件）
    // Enable Vite's module resolution behavior (supports extensionless file imports in projects that use modules)
    "moduleResolution": "bundler",

    // Vite 建议开启此选项：代码涉及到 Vite 不支持的”隔离相关特性“时，显示警告。
    // Vite recommends enabling this option so TypeScript warns about code that uses features Vite cannot support when transpiling files in isolation
    "isolatedModules": true,

    // 开启 isolatedModules 的情况下，一些库（如 Vue）会报错，通过此选项缓解此问题。
    // Some libraries, such as Vue, report errors when `isolatedModules` is enabled; this option mitigates the issue
    "skipLibCheck": true,

    // 补充类型定义，如 svg 等导入资源的类型；假定项目包含了以下依赖：vite、vite-plugin-svgr
    // 注意：指定此项会导致 node_modules/@types 中的类型不会自动被引入，需要手动引用到相关包才被引入
    // Add type definitions for imported assets such as SVG files; assumes the project includes the following dependencies: vite and vite-plugin-svgr
    // Note: specifying this option prevents types in `node_modules/@types` from being included automatically; packages must be referenced explicitly to include their types
    "types": ["vite-plugin-svgr/client", "vite/client"]
  }
}
