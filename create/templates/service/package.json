{
  "private": true,
  "name": "project",
  "description": "服务端项目",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc-with-alias --project tsconfig.build.json",
    "watch": "rm -rf dist && tsc-with-alias --watch --project tsconfig.build.json",
    "dev": "rm -rf dist && tsc-with-alias --watch --project tsconfig.build.json --nodemon=dist/index.js",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit && eslint './src/'",
    "db-generate": "prisma generate --sql",
    "db-push": "prisma db push",
    "db-save": "prisma migrate dev",
    "db-deploy": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@stdex/logging": "workspace:*",
    "@stdex/utils": "workspace:*",
    "@stdex/utils-node": "workspace:*",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "dayjs": "latest",
    "debug": "latest",
    "dotenv": "latest",
    "lodash": "latest",
    "pg": "latest",
    "redis": "latest",
    "starlight-server": "latest"
  },
  "devDependencies": {
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/debug": "latest",
    "@types/lodash": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "nodemon": "latest",
    "prisma": "^7.10.1",
    "tsc-alias": "latest",
    "typescript": "^6.0.3"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
