{
  "name": "@stdex/create",
  "version": "1.2.1",
  "description": "npm init 项目模板 - Project Templates For 'npm init'",
  "homepage": "https://github.com/anjianshi/stdex-packages/tree/master/create/",
  "type": "module",
  "scripts": {
    "dev": "rm -rf test && node ./src/index.js base --name=test",
    "lint": "eslint './src/**/*'"
  },
  "bin": {
    "create": "./src/index.js"
  },
  "files": [
    "src",
    "templates",
    "!templates/**/node_modules",
    "!templates/**/.swc",
    "!templates/**/.DS_Store",
    "!templates/**/dist"
  ],
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": "github:anjianshi/stdex-packages",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "eslint": "^10.6.0"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
