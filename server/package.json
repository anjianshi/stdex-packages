{
  "name": "@stdex/server",
  "version": "1.2.0",
  "description": "Simple But Powerful Node.js HTTP Server",
  "type": "module",
  "scripts": {
    "demo": "rimraf dist && tsc-with-alias --watch --nodemon=dist/demo/index.js",
    "build": "rimraf dist && tsc-with-alias",
    "watch": "rimraf dist && tsc-with-alias --watch",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/**/*'"
  },
  "keywords": [
    "web",
    "app",
    "http",
    "framework"
  ],
  "homepage": "https://github.com/anjianshi/stdex-packages/tree/master/server",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": "github:anjianshi/stdex-packages",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@stdex/utils": "workspace:*",
    "@stdex/utils-node": "workspace:*",
    "@stdex/validator": "workspace:*",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "swagger-ui-dist": "^5.33.1"
  },
  "devDependencies": {
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.20.5",
    "@types/swagger-ui-dist": "^3.30.6",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "rimraf": "^5.0.10",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.3"
  },
  "eslintIgnore": [],
  "prettier": "@stdex/presets-prettier/prettierrc"
}
