{
  "name": "@stdex/utils-node",
  "version": "1.3.0",
  "description": "Node.js 脚本及后端服务工具库",
  "homepage": "https://github.com/anjianshi/stdex-packages/utils-node",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjianshi/stdex-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clear && tsc",
    "watch": "npm run clear && tsc --watch",
    "clear": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/'"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    }
  },
  "files": [
    "src/",
    "dist/"
  ],
  "dependencies": {
    "@stdex/utils": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.6.0",
    "redis": "^6.1.0",
    "typescript": "^6.0.3"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
