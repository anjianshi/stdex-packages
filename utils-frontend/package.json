{
  "name": "@stdex/utils-frontend",
  "version": "1.2.0",
  "description": "浏览器环境及 React 应用工具库",
  "homepage": "https://github.com/anjianshi/stdex-packages/utils-frontend",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjianshi/stdex-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clear && tsc",
    "watch": "npm run clear && tsc --watch",
    "clear": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/'"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./react/*.js": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    },
    "./react/*.jsx": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.jsx"
    }
  },
  "files": [
    "src/",
    "dist/"
  ],
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/serialize": "^1.3.3",
    "@emotion/utils": "^1.4.2",
    "@stdex/presets-eslint-react": "workspace:*",
    "@stdex/presets-eslint-typescript": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vconsole": "^3.15.1"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
