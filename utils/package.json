{
  "name": "@stdex/utils",
  "version": "1.2.0",
  "description": "通用工具库",
  "homepage": "https://github.com/anjianshi/stdex-packages/utils",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-packages/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjianshi/stdex-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "watch": "npm run clear && tsc --watch",
    "build": "npm run clear && tsc",
    "clear": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/'"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@stdex/presets-eslint-typescript": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/lodash": "^4.17.24",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
