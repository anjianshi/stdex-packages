{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc-with-alias -p tsconfig.json",
    "watch": "rm -rf dist && tsc-with-alias -p tsconfig.json --watch",
    "loop": "rm -rf dist && tsc-with-alias -p tsconfig.json --watch --nodemon=dist/typescript/loop.js",
    "lint": "tsc -p tsconfig-build.json --noEmit"
  },
  "prettier": "@stdex/presets-prettier/prettierrc",
  "dependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@stdex/presets-eslint-base": "workspace:*",
    "@stdex/presets-eslint-node": "workspace:*",
    "@stdex/presets-eslint-react": "workspace:*",
    "@stdex/presets-prettier": "workspace:*",
    "@stdex/presets-typescript": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.3"
  }
}
